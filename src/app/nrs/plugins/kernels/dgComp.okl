// Compressible DGSEM kernels (port of CompNek5000).
//
// Defines set by dgComp::buildKernel:
//   p_Nspec, p_Npa, p_Neq (= 4 + p_Nspec), p_Nprim, p_Ntrace (= p_Neq + p_Nprim), p_Ru
//   p_perfectGas (1: single component, constant gamma; 0: NASA polynomials),
//   p_gamma, p_cv (perfect gas only)
//   p_PRHO, p_PU, p_PV, p_PW, p_PP, p_PT, p_PGAMMA, p_PASPD, p_PH, p_PWMEAN, p_PY0
//   p_Nvisc (= 4 + p_Nspec for p_Nspec > 1, else 4): BR1 gradient variables
//   and viscous-flux rows
//
// Conserved fields (stride offset): 0..2 rho*u, 3 rho*E, 4.. rho*Y_k.
// Trace arrays (stride faceOffset): sk = e*p_NfacesNfp + f*p_Nfp + n,
// the p_Neq conserved fields followed by the p_Nprim primitives.

#define p_newtonTol 1e-8
#define p_newtonMaxIt 1000
#define p_newtonT0 500.0
#define p_Tclip 298.0

// Port of compvar.f::eval_dependent_vars (EOS part; transport, reaction rates
// and entropy are not computed here).
// The species sum is folded into mixture polynomials before the Newton loop,
// which is algebraically the same as the Fortran per-iteration species loop.
@kernel void dgPrimitives(const dlong N,
                          const dlong offset,
                          const int clip,
                          @ restrict const dfloat *mw,
                          @ restrict const dfloat *bi,
                          @ restrict const dfloat *aa,
                          @ restrict dfloat *U,
                          @ restrict dfloat *P)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    if (n < N) {
      dfloat rho = 0;
      for (int k = 0; k < p_Nspec; k++) {
        rho += U[n + (4 + k) * offset];
      }
      const dfloat invRho = 1 / rho;

      dfloat Y[p_Nspec];
      if (clip) {
        dfloat ysum = 0;
        for (int k = 0; k < p_Nspec; k++) {
          Y[k] = fmax(U[n + (4 + k) * offset], 0.0) * invRho;
          ysum += Y[k];
        }
        for (int k = 0; k < p_Nspec; k++) {
          Y[k] /= ysum;
          U[n + (4 + k) * offset] = rho * Y[k];
        }
      } else {
        for (int k = 0; k < p_Nspec; k++) {
          Y[k] = U[n + (4 + k) * offset] * invRho;
        }
      }

      dfloat wminv = 0;
      for (int k = 0; k < p_Nspec; k++) {
        wminv += Y[k] / mw[k];
      }
      const dfloat Wmean = 1 / wminv;

      const dfloat u = U[n + 0 * offset] * invRho;
      const dfloat v = U[n + 1 * offset] * invRho;
      const dfloat w = U[n + 2 * offset] * invRho;
      const dfloat kinE = 0.5 * (u * u + v * v + w * w);
      const dfloat intE = U[n + 3 * offset] * invRho - kinE;

#if p_perfectGas
      // e = cv T, no Newton iteration needed
      const dfloat T = intE / p_cv;
      const dfloat gamma = p_gamma;
#else
      // mixture coefficients: u(T) = sum_c b[c] T^c, cp(T) = sum_c a[c] T^c
      dfloat b[p_Npa + 1];
      dfloat a[p_Npa];
      for (int c = 0; c <= p_Npa; c++) {
        b[c] = 0;
      }
      for (int c = 0; c < p_Npa; c++) {
        a[c] = 0;
      }
      for (int k = 0; k < p_Nspec; k++) {
        for (int c = 0; c <= p_Npa; c++) {
          b[c] += Y[k] * bi[k * (p_Npa + 1) + c];
        }
        for (int c = 0; c < p_Npa; c++) {
          a[c] += Y[k] * aa[k * p_Npa + c];
        }
      }

      // Newton for T, same start, tolerance and cap as the Fortran
      dfloat T = p_newtonT0;
      dfloat dT = 1;
      int it = 0;
      while (fabs(dT) > p_newtonTol && it <= p_newtonMaxIt) {
        it++;
        dfloat u0 = b[p_Npa];
        dfloat dudT = p_Npa * b[p_Npa];
        for (int c = p_Npa - 1; c >= 1; c--) {
          u0 = u0 * T + b[c];
          dudT = dudT * T + c * b[c];
        }
        u0 = u0 * T + b[0] - intE;
        dT = -u0 / dudT;
        T += dT;
      }
      if (clip && T < p_Tclip) {
        T = p_Tclip;
      }

      dfloat cp = a[p_Npa - 1];
      for (int c = p_Npa - 2; c >= 0; c--) {
        cp = cp * T + a[c];
      }
      const dfloat gamma = cp / (cp - p_Ru / Wmean);
#endif

      // perfect gas: Wmean = Ru/R, so p = rho R T
      const dfloat p = rho * T * p_Ru / Wmean;

      P[n + p_PRHO * offset] = rho;
      P[n + p_PU * offset] = u;
      P[n + p_PV * offset] = v;
      P[n + p_PW * offset] = w;
      P[n + p_PP * offset] = p;
      P[n + p_PT * offset] = T;
      P[n + p_PGAMMA * offset] = gamma;
      P[n + p_PASPD * offset] = sqrt(p * gamma * invRho);
      P[n + p_PH * offset] = (U[n + 3 * offset] + p) * invRho;
      P[n + p_PWMEAN * offset] = Wmean;
      for (int k = 0; k < p_Nspec; k++) {
        P[n + (p_PY0 + k) * offset] = Y[k];
      }
    }
  }
}

// Conserved variables from (velocity, p, T, Y), as in the CompNek5000 useric.
// For a perfect gas the host sets bi = {0, cv} and mw = Ru/R, so the
// polynomial below reduces to e = cv T and rho = p / (R T).
@kernel void dgConserved(const dlong N,
                         const dlong offset,
                         @ restrict const dfloat *mw,
                         @ restrict const dfloat *bi,
                         @ restrict const dfloat *vel,
                         @ restrict const dfloat *pr,
                         @ restrict const dfloat *temp,
                         @ restrict const dfloat *Y,
                         @ restrict dfloat *U)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    if (n < N) {
      const dfloat T = temp[n];

      dfloat wminv = 0;
      dfloat intE = 0;
      for (int k = 0; k < p_Nspec; k++) {
        const dfloat Yk = Y[n + k * offset];
        wminv += Yk / mw[k];
        dfloat uk = bi[k * (p_Npa + 1) + p_Npa];
        for (int c = p_Npa - 1; c >= 0; c--) {
          uk = uk * T + bi[k * (p_Npa + 1) + c];
        }
        intE += Yk * uk;
      }
      const dfloat rho = pr[n] / (p_Ru * T * wminv); // eval_EOS_D

      const dfloat u = vel[n + 0 * offset];
      const dfloat v = vel[n + 1 * offset];
      const dfloat w = vel[n + 2 * offset];
      const dfloat totE = intE + 0.5 * (u * u + v * v + w * w);

      U[n + 0 * offset] = rho * u;
      U[n + 1 * offset] = rho * v;
      U[n + 2 * offset] = rho * w;
      U[n + 3 * offset] = rho * totE;
      for (int k = 0; k < p_Nspec; k++) {
        U[n + (4 + k) * offset] = rho * Y[n + k * offset];
      }
    }
  }
}

// Copy volume values to the element's own face nodes (the "M" side).
@kernel void dgTraceGather(const dlong Nelements,
                           const dlong offset,
                           const dlong faceOffset,
                           @ restrict const dlong *vmapM,
                           @ restrict const dfloat *U,
                           @ restrict const dfloat *P,
                           @ restrict dfloat *faceM)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    for (int n = 0; n < p_NfacesNfp; ++n; @inner(0)) {
      const dlong sk = e * p_NfacesNfp + n;
      const dlong idM = vmapM[sk];
      for (int f = 0; f < p_Neq; f++) {
        faceM[sk + f * faceOffset] = U[idM + f * offset];
      }
      for (int f = 0; f < p_Nprim; f++) {
        faceM[sk + (p_Neq + f) * faceOffset] = P[idM + f * offset];
      }
    }
  }
}

// Pirozzoli KEP two-point flux (advect.f::getFlux_KEP) between node 1 and
// node 2, contracted with the metric vector m = (mx, my, mz) of node 1 and
// multiplied by c (= 2 D_il). Added to f.
//   rho Y_k: {rho}{u.m}{Y_k}
//   rho u_d: {rho}{u.m}{u_d} + {p} m_d
//   rho E:   {rho}{u.m}{H},   H = (rho E + p)/rho
// Node 2 mass fractions are read from P at id2.
void kepFluxAdd(const dfloat c,
                const dfloat mx,
                const dfloat my,
                const dfloat mz,
                const dfloat rho1,
                const dfloat u1,
                const dfloat v1,
                const dfloat w1,
                const dfloat p1,
                const dfloat H1,
                const dfloat *Y1,
                const dfloat rho2,
                const dfloat u2,
                const dfloat v2,
                const dfloat w2,
                const dfloat p2,
                const dfloat H2,
                const dfloat *P,
                const dlong id2,
                const dlong offset,
                dfloat *f)
{
  const dfloat uA = 0.5 * (u1 + u2);
  const dfloat vA = 0.5 * (v1 + v2);
  const dfloat wA = 0.5 * (w1 + w2);
  const dfloat unA = uA * mx + vA * my + wA * mz;
  const dfloat cpA = c * 0.5 * (p1 + p2);
  const dfloat mflux = c * 0.5 * (rho1 + rho2) * unA;

  f[0] += mflux * uA + cpA * mx;
  f[1] += mflux * vA + cpA * my;
  f[2] += mflux * wA + cpA * mz;
  f[3] += mflux * 0.5 * (H1 + H2);
  for (int s = 0; s < p_Nspec; s++) {
    f[4 + s] += mflux * 0.5 * (Y1[s] + P[id2 + (p_PY0 + s) * offset]);
  }
}

// Flux-differencing volume term, port of advect.f::advect_volInt (KEP only).
// Fortran, per node (i,j,k):
//   rkRHS = sum_l 2 D(i,l) F#((i,j,k),(l,j,k)).(rx,ry,rz)
//         + sum_l 2 D(j,l) F#((i,j,k),(i,l,k)).(sx,sy,sz)
//         + sum_l 2 D(k,l) F#((i,j,k),(i,j,l)).(tx,ty,tz)
// with Nek5000 rxm1/jacm1 = dr/dx, which is what vgeo holds. The metrics are
// those of node (i,j,k), not averaged, as in the Fortran.
// rkRHS is -dU/dt, so rhs = -rkRHS. This kernel sets rhs; the surface lift
// adds to it afterwards.
// Shared memory: 6 Nq^3 + Nq^2 dfloats (24.6 kB at N = 7). Mass fractions of
// the partner node are read from global memory to keep this independent of
// nspec.
@kernel void dgVolumeRhsHex3D(const dlong Nelements,
                              const dlong offset,
                              @ restrict const dfloat *vgeo,
                              @ restrict const dfloat *D,
                              @ restrict const dfloat *P,
                              @ restrict dfloat *rhs)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    @shared dfloat s_D[p_Nq][p_Nq];
    @shared dfloat s_rho[p_Nq][p_Nq][p_Nq];
    @shared dfloat s_u[p_Nq][p_Nq][p_Nq];
    @shared dfloat s_v[p_Nq][p_Nq][p_Nq];
    @shared dfloat s_w[p_Nq][p_Nq][p_Nq];
    @shared dfloat s_p[p_Nq][p_Nq][p_Nq];
    @shared dfloat s_H[p_Nq][p_Nq][p_Nq];

    for (int j = 0; j < p_Nq; ++j; @inner(1)) {
      for (int i = 0; i < p_Nq; ++i; @inner(0)) {
        s_D[j][i] = D[j * p_Nq + i];
        for (int k = 0; k < p_Nq; ++k) {
          const dlong id = e * p_Np + k * p_Nfp + j * p_Nq + i;
          s_rho[k][j][i] = P[id + p_PRHO * offset];
          s_u[k][j][i] = P[id + p_PU * offset];
          s_v[k][j][i] = P[id + p_PV * offset];
          s_w[k][j][i] = P[id + p_PW * offset];
          s_p[k][j][i] = P[id + p_PP * offset];
          s_H[k][j][i] = P[id + p_PH * offset];
        }
      }
    }

    @barrier();

    for (int j = 0; j < p_Nq; ++j; @inner(1)) {
      for (int i = 0; i < p_Nq; ++i; @inner(0)) {
        for (int k = 0; k < p_Nq; ++k) {
          const dlong id = e * p_Np + k * p_Nfp + j * p_Nq + i;
          const dlong gid = e * p_Np * p_Nvgeo + k * p_Nfp + j * p_Nq + i;
          const dfloat rx = vgeo[gid + p_RXID * p_Np];
          const dfloat ry = vgeo[gid + p_RYID * p_Np];
          const dfloat rz = vgeo[gid + p_RZID * p_Np];
          const dfloat sx = vgeo[gid + p_SXID * p_Np];
          const dfloat sy = vgeo[gid + p_SYID * p_Np];
          const dfloat sz = vgeo[gid + p_SZID * p_Np];
          const dfloat tx = vgeo[gid + p_TXID * p_Np];
          const dfloat ty = vgeo[gid + p_TYID * p_Np];
          const dfloat tz = vgeo[gid + p_TZID * p_Np];

          const dfloat rho1 = s_rho[k][j][i];
          const dfloat u1 = s_u[k][j][i];
          const dfloat v1 = s_v[k][j][i];
          const dfloat w1 = s_w[k][j][i];
          const dfloat p1 = s_p[k][j][i];
          const dfloat H1 = s_H[k][j][i];
          dfloat Y1[p_Nspec];
          for (int s = 0; s < p_Nspec; s++) {
            Y1[s] = P[id + (p_PY0 + s) * offset];
          }

          dfloat f[p_Neq];
          for (int q = 0; q < p_Neq; q++) {
            f[q] = 0;
          }

          // r direction, partner (l,j,k)
          for (int l = 0; l < p_Nq; ++l) {
            const dlong id2 = e * p_Np + k * p_Nfp + j * p_Nq + l;
            kepFluxAdd(2 * s_D[i][l], rx, ry, rz,
                       rho1, u1, v1, w1, p1, H1, Y1,
                       s_rho[k][j][l], s_u[k][j][l], s_v[k][j][l], s_w[k][j][l], s_p[k][j][l], s_H[k][j][l],
                       P, id2, offset, f);
          }
          // s direction, partner (i,l,k)
          for (int l = 0; l < p_Nq; ++l) {
            const dlong id2 = e * p_Np + k * p_Nfp + l * p_Nq + i;
            kepFluxAdd(2 * s_D[j][l], sx, sy, sz,
                       rho1, u1, v1, w1, p1, H1, Y1,
                       s_rho[k][l][i], s_u[k][l][i], s_v[k][l][i], s_w[k][l][i], s_p[k][l][i], s_H[k][l][i],
                       P, id2, offset, f);
          }
          // t direction, partner (i,j,l)
          for (int l = 0; l < p_Nq; ++l) {
            const dlong id2 = e * p_Np + l * p_Nfp + j * p_Nq + i;
            kepFluxAdd(2 * s_D[k][l], tx, ty, tz,
                       rho1, u1, v1, w1, p1, H1, Y1,
                       s_rho[l][j][i], s_u[l][j][i], s_v[l][j][i], s_w[l][j][i], s_p[l][j][i], s_H[l][j][i],
                       P, id2, offset, f);
          }

          for (int q = 0; q < p_Neq; q++) {
            rhs[id + q * offset] = -f[q];
          }
        }
      }
    }
  }
}

// Physical normal flux F(U).n of one state (riemann.f::phys_flux).
// E is total energy per volume (rho E).
void physFlux(const dfloat nx,
              const dfloat ny,
              const dfloat nz,
              const dfloat rho,
              const dfloat u,
              const dfloat v,
              const dfloat w,
              const dfloat p,
              const dfloat E,
              const dfloat *Y,
              dfloat *f)
{
  const dfloat un = u * nx + v * ny + w * nz;
  f[0] = rho * u * un + p * nx;
  f[1] = rho * v * un + p * ny;
  f[2] = rho * w * un + p * nz;
  f[3] = (E + p) * un;
  for (int s = 0; s < p_Nspec; s++) {
    f[4 + s] = rho * Y[s] * un;
  }
}

// HLL flux (riemann.f::flux_hll); q* are the conserved states.
void fluxHLL(const dfloat sL,
             const dfloat sR,
             const dfloat *fL,
             const dfloat *fR,
             const dfloat *qL,
             const dfloat *qR,
             dfloat *f)
{
  if (sL >= 0) {
    for (int q = 0; q < p_Neq; q++) {
      f[q] = fL[q];
    }
  } else if (sR <= 0) {
    for (int q = 0; q < p_Neq; q++) {
      f[q] = fR[q];
    }
  } else {
    const dfloat inv = 1 / (sR - sL);
    for (int q = 0; q < p_Neq; q++) {
      f[q] = (sR * fL[q] - sL * fR[q] + sL * sR * (qR[q] - qL[q])) * inv;
    }
  }
}

// Toro's HLLC flux (riemann.f::flux_hllc).
void fluxHLLC(const dfloat sL,
              const dfloat sR,
              const dfloat nx,
              const dfloat ny,
              const dfloat nz,
              const dfloat rhoL,
              const dfloat uL,
              const dfloat vL,
              const dfloat wL,
              const dfloat pL,
              const dfloat EL,
              const dfloat *YL,
              const dfloat *fL,
              const dfloat *qL,
              const dfloat rhoR,
              const dfloat uR,
              const dfloat vR,
              const dfloat wR,
              const dfloat pR,
              const dfloat ER,
              const dfloat *YR,
              const dfloat *fR,
              const dfloat *qR,
              dfloat *f)
{
  if (sL >= 0) {
    for (int q = 0; q < p_Neq; q++) {
      f[q] = fL[q];
    }
    return;
  }
  if (sR <= 0) {
    for (int q = 0; q < p_Neq; q++) {
      f[q] = fR[q];
    }
    return;
  }

  const dfloat unL = uL * nx + vL * ny + wL * nz;
  const dfloat unR = uR * nx + vR * ny + wR * nz;
  const dfloat sM = (pR - pL + rhoL * unL * (sL - unL) - rhoR * unR * (sR - unR)) /
                    (rhoL * (sL - unL) - rhoR * (sR - unR));

  const int left = (sM >= 0);
  const dfloat sK = left ? sL : sR;
  const dfloat rhoK = left ? rhoL : rhoR;
  const dfloat uK = left ? uL : uR;
  const dfloat vK = left ? vL : vR;
  const dfloat wK = left ? wL : wR;
  const dfloat pK = left ? pL : pR;
  const dfloat EK = left ? EL : ER;
  const dfloat unK = left ? unL : unR;
  const dfloat *YK = left ? YL : YR;
  const dfloat *fK = left ? fL : fR;
  const dfloat *qK = left ? qL : qR;

  const dfloat fac = rhoK * (sK - unK) / (sK - sM);
  dfloat qs[p_Neq];
  qs[0] = fac * (uK + (sM - unK) * nx);
  qs[1] = fac * (vK + (sM - unK) * ny);
  qs[2] = fac * (wK + (sM - unK) * nz);
  qs[3] = fac * (EK / rhoK + (sM - unK) * (sM + pK / (rhoK * (sK - unK))));
  for (int s = 0; s < p_Nspec; s++) {
    qs[4 + s] = fac * YK[s];
  }

  for (int q = 0; q < p_Neq; q++) {
    f[q] = fK[q] + sK * (qs[q] - qK[q]);
  }
}

// Interface flux at every trace node, port of advect.f::advect_interface
// (solver 0, LLF) and riemann.f::advect_interface_riemann (1 HLL, 2 HLLC,
// 3 HLLC blended into HLL). Same numbering as CompNek5000 userparam05.
// M = own face state, P = neighbour = faceP - faceM (faceP holds M + P after
// the gs-add). Interior faces only: setup refuses meshes with boundary faces.
// Writes the lifted contribution with the nekRS sign,
//   faceFlux = -(F* - F(U_M)).n * sJ w_face / (J w_vol),
// which the Fortran adds as +(F* - F_M).n area/bm1 to rkRHS (= -dU/dt).
// LLF: F* = Fnd.n - lambda/2 (U_P - U_M), lambda = max over both sides of
// a + |u.n| (eval_lmf), and Fnd either the KEP average of the two face states
// (fullLLF = 0, Fortran default) or (F(U_M) + F(U_P))/2 (fullLLF = 1,
// ifIntLLFfull).
@kernel void dgSurfaceFluxHex3D(const dlong Ntrace,
                                const dlong faceOffset,
                                const int solver,
                                const int fullLLF,
                                const dfloat sw0,
                                const dfloat sw1,
                                const dfloat swRho,
                                @ restrict const dfloat *sgeo,
                                @ restrict const dfloat *faceM,
                                @ restrict const dfloat *faceP,
                                @ restrict dfloat *faceFlux)
{
  for (dlong sk = 0; sk < Ntrace; ++sk; @tile(p_blockSize, @outer, @inner)) {
    if (sk < Ntrace) {
      const dfloat nx = sgeo[sk * p_Nsgeo + p_NXID];
      const dfloat ny = sgeo[sk * p_Nsgeo + p_NYID];
      const dfloat nz = sgeo[sk * p_Nsgeo + p_NZID];
      const dfloat scale = sgeo[sk * p_Nsgeo + p_WSJID] * sgeo[sk * p_Nsgeo + p_IJWID];

      // conserved states
      dfloat qM[p_Neq], qP[p_Neq];
      for (int q = 0; q < p_Neq; q++) {
        qM[q] = faceM[sk + q * faceOffset];
        qP[q] = faceP[sk + q * faceOffset] - qM[q];
      }

#define primM(fld) faceM[sk + (p_Neq + (fld)) * faceOffset]
#define primP(fld) (faceP[sk + (p_Neq + (fld)) * faceOffset] - primM(fld))
      const dfloat rhoM = primM(p_PRHO), rhoP = primP(p_PRHO);
      const dfloat uM = primM(p_PU), uP = primP(p_PU);
      const dfloat vM = primM(p_PV), vP = primP(p_PV);
      const dfloat wM = primM(p_PW), wP = primP(p_PW);
      const dfloat pM = primM(p_PP), pP = primP(p_PP);
      const dfloat HM = primM(p_PH), HP = primP(p_PH);
      dfloat YM[p_Nspec], YP[p_Nspec];
      for (int s = 0; s < p_Nspec; s++) {
        YM[s] = primM(p_PY0 + s);
        YP[s] = primP(p_PY0 + s);
      }

      const dfloat unM = uM * nx + vM * ny + wM * nz;
      const dfloat unP = uP * nx + vP * ny + wP * nz;

      dfloat fM[p_Neq], fP[p_Neq], fs[p_Neq];
      physFlux(nx, ny, nz, rhoM, uM, vM, wM, pM, qM[3], YM, fM);
      physFlux(nx, ny, nz, rhoP, uP, vP, wP, pP, qP[3], YP, fP);

      if (solver == 0) {
        const dfloat lambda = fmax(primM(p_PASPD) + fabs(unM), primP(p_PASPD) + fabs(unP));
        if (fullLLF) {
          for (int q = 0; q < p_Neq; q++) {
            fs[q] = 0.5 * (fM[q] + fP[q]);
          }
        } else {
          const dfloat uA = 0.5 * (uM + uP);
          const dfloat vA = 0.5 * (vM + vP);
          const dfloat wA = 0.5 * (wM + wP);
          const dfloat pA = 0.5 * (pM + pP);
          const dfloat mflux = 0.5 * (rhoM + rhoP) * (uA * nx + vA * ny + wA * nz);
          fs[0] = mflux * uA + pA * nx;
          fs[1] = mflux * vA + pA * ny;
          fs[2] = mflux * wA + pA * nz;
          fs[3] = mflux * 0.5 * (HM + HP);
          for (int s = 0; s < p_Nspec; s++) {
            fs[4 + s] = mflux * 0.5 * (YM[s] + YP[s]);
          }
        }
        for (int q = 0; q < p_Neq; q++) {
          fs[q] -= 0.5 * lambda * (qP[q] - qM[q]);
        }
      } else {
        const dfloat aM = sqrt(primM(p_PGAMMA) * pM / rhoM);
        const dfloat aP = sqrt(primP(p_PGAMMA) * pP / rhoP);

        // Davis wave speed estimates
        const dfloat sL = fmin(unM - aM, unP - aP);
        const dfloat sR = fmax(unM + aM, unP + aP);

        dfloat alpha = 0;
        if (solver == 1) {
          alpha = 1;
        } else if (solver == 3) {
          const dfloat sp = fabs(pP - pM) / (pP + pM);
          alpha = fmin(1.0, fmax(0.0, (sp - sw0) / (sw1 - sw0)));
          if (fabs(unM) / aM < 1 || fabs(unP) / aP < 1) {
            const dfloat srho = fabs(rhoP - rhoM) / (rhoP + rhoM);
            alpha *= fmax(0.0, 1 - srho / swRho);
          }
        }

        dfloat fhll[p_Neq];
        if (alpha > 0) {
          fluxHLL(sL, sR, fM, fP, qM, qP, fhll);
        }
        if (alpha < 1) {
          fluxHLLC(sL, sR, nx, ny, nz,
                   rhoM, uM, vM, wM, pM, qM[3], YM, fM, qM,
                   rhoP, uP, vP, wP, pP, qP[3], YP, fP, qP,
                   fs);
        }
        if (alpha >= 1) {
          for (int q = 0; q < p_Neq; q++) {
            fs[q] = fhll[q];
          }
        } else if (alpha > 0) {
          for (int q = 0; q < p_Neq; q++) {
            fs[q] = alpha * fhll[q] + (1 - alpha) * fs[q];
          }
        }
      }
#undef primM
#undef primP

      for (int q = 0; q < p_Neq; q++) {
        faceFlux[sk + q * faceOffset] = -(fs[q] - fM[q]) * scale;
      }
    }
  }
}

// Add the face contributions from dgSurfaceFluxHex3D to rhs. Thread (i,j)
// owns the column (i,j,0..Nq-1), so the edge and corner nodes shared by
// several faces are summed by a single thread (no write races).
// Face node ordering (meshBasisHex3D.cpp::FaceNodesHex3D):
//   face 0 (t=-1), 5 (t=+1): n = i + j Nq
//   face 1 (s=-1), 3 (s=+1): n = i + k Nq
//   face 4 (r=-1), 2 (r=+1): n = j + k Nq
@kernel void dgSurfaceLiftHex3D(const dlong Nelements,
                                const dlong offset,
                                const dlong faceOffset,
                                @ restrict const dfloat *faceFlux,
                                @ restrict dfloat *rhs)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    for (int j = 0; j < p_Nq; ++j; @inner(1)) {
      for (int i = 0; i < p_Nq; ++i; @inner(0)) {
        const dlong base = e * p_NfacesNfp;
        const int onSide = (i == 0 || i == p_Nq - 1 || j == 0 || j == p_Nq - 1);
        for (int k = 0; k < p_Nq; ++k) {
          if (!onSide && k != 0 && k != p_Nq - 1) {
            continue;
          }
          const dlong id = e * p_Np + k * p_Nfp + j * p_Nq + i;
          for (int q = 0; q < p_Neq; q++) {
            const dfloat *ff = faceFlux + q * faceOffset + base;
            dfloat s = 0;
            if (k == 0) {
              s += ff[0 * p_Nfp + i + j * p_Nq];
            }
            if (k == p_Nq - 1) {
              s += ff[5 * p_Nfp + i + j * p_Nq];
            }
            if (j == 0) {
              s += ff[1 * p_Nfp + i + k * p_Nq];
            }
            if (j == p_Nq - 1) {
              s += ff[3 * p_Nfp + i + k * p_Nq];
            }
            if (i == 0) {
              s += ff[4 * p_Nfp + j + k * p_Nq];
            }
            if (i == p_Nq - 1) {
              s += ff[2 * p_Nfp + j + k * p_Nq];
            }
            rhs[id + q * offset] += s;
          }
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Viscous terms (BR1), port of viscous.f, entrovisc.f::liftGrad/divQ_weak and
// compvar.f transport (vis1, cond1, diff1).
//
// Gradient variables g (p_Nvisc of them): 0..2 u, v, w; 3 T; 4+k X_k (mole
// fractions, nspec > 1 only).
//   grad[(3 g + d) offset + id]       d(var_g)/dx_d
// Viscous flux rows q (also p_Nvisc), one per conserved equation that has a
// viscous term: 0..2 momentum (tau), 3 energy (u.tau + q), 4+k rho Y_k (J_k).
//   vflux[(3 q + d) offset + id]      F_q,d
// Signs as in the Fortran, where rkRHS = -dU/dt gets -div: here
//   dU/dt += div(F), q = +lambda grad T + sum h_k J_k, J_k = +rho D_k W_k/W grad X_k
// ---------------------------------------------------------------------------

#define p_TinyX 1e-20 // Cantera MixTransport: X_k = max(Tiny, X_k)

// dot product of a 5-term polynomial in ln T (Cantera dot5 with polytempvec)
dfloat dot5LogT(const dfloat *c, const dfloat *lt)
{
  return c[0] + c[1] * lt[1] + c[2] * lt[2] + c[3] * lt[3] + c[4] * lt[4];
}

// Transport properties at every node, compvar.f lines 158-166:
//   trans[0 offset] mu, trans[1 offset] lambda, trans[(2+k) offset] rho D_k
// mode 0 (constant): mu = mu0, lambda = mu cp(T)/Pr, rho D_k = mu/(Pr Le).
// mode 1 (fits): Cantera mixture-averaged transport (MixTransport, not CK
// mode) evaluated from its own polynomial fits, exported by
// exportTransport.py (5 coefficients per fit, ascending powers of ln T):
//   mu_k = (T^1/4 visc_k(lnT))^2, lambda_k = sqrt(T) cond_k(lnT),
//   D_jk = T^3/2 diff_jk(lnT) / p
//   mu = sum_k X_k mu_k / sum_j X_j phi_kj (Wilke, Cantera updateViscosity_T)
//   lambda = (sum_k X_k lambda_k + 1/sum_k (X_k/lambda_k)) / 2
//   D_k = (W - X_k W_k) / (p W sum_{j!=k} X_j/D_jk), D_kk/p if that sum <= 0
// X_k is clipped at 1e-20 as in Cantera; W uses the unclipped mixture.
@kernel void dgTransport(const dlong N,
                         const dlong offset,
                         const int mode,
                         const dfloat mu0,
                         const dfloat Pr,
                         const dfloat Le,
                         @ restrict const dfloat *aa,
                         @ restrict const dfloat *mw,
                         @ restrict const dfloat *viscFit,
                         @ restrict const dfloat *condFit,
                         @ restrict const dfloat *diffFit,
                         @ restrict const dfloat *P,
                         @ restrict dfloat *trans)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    if (n < N) {
      const dfloat T = P[n + p_PT * offset];
      const dfloat rho = P[n + p_PRHO * offset];
      dfloat Y[p_Nspec];
      for (int k = 0; k < p_Nspec; k++) {
        Y[k] = P[n + (p_PY0 + k) * offset];
      }

      if (mode == 0) {
        dfloat cp = 0;
        for (int k = 0; k < p_Nspec; k++) {
          dfloat cpk = aa[k * p_Npa + p_Npa - 1];
          for (int c = p_Npa - 2; c >= 0; c--) {
            cpk = cpk * T + aa[k * p_Npa + c];
          }
          cp += Y[k] * cpk;
        }
        trans[n + 0 * offset] = mu0;
        trans[n + 1 * offset] = mu0 * cp / Pr;
        for (int k = 0; k < p_Nspec; k++) {
          trans[n + (2 + k) * offset] = mu0 / (Pr * Le);
        }
      } else {
        const dfloat p = P[n + p_PP * offset];
        const dfloat W = P[n + p_PWMEAN * offset];
        const dfloat sqrtT = sqrt(T);
        const dfloat t14 = sqrt(sqrtT);

        dfloat lt[5];
        lt[0] = 1;
        lt[1] = log(T);
        lt[2] = lt[1] * lt[1];
        lt[3] = lt[2] * lt[1];
        lt[4] = lt[3] * lt[1];

        dfloat X[p_Nspec], sqmu[p_Nspec], muk[p_Nspec];
        dfloat sum1 = 0, sum2 = 0;
        for (int k = 0; k < p_Nspec; k++) {
          X[k] = fmax(p_TinyX, Y[k] * W / mw[k]);
          sqmu[k] = t14 * dot5LogT(viscFit + 5 * k, lt);
          muk[k] = sqmu[k] * sqmu[k];
          const dfloat lamk = sqrtT * dot5LogT(condFit + 5 * k, lt);
          sum1 += X[k] * lamk;
          sum2 += X[k] / lamk;
        }

        dfloat mu = 0;
        for (int k = 0; k < p_Nspec; k++) {
          dfloat den = 0;
          for (int j = 0; j < p_Nspec; j++) {
            // phi_kj = (1 + sqrt(mu_k/mu_j) (W_j/W_k)^1/4)^2 / sqrt(8 (1 + W_k/W_j))
            const dfloat f1 = 1 + (sqmu[k] / sqmu[j]) * sqrt(sqrt(mw[j] / mw[k]));
            den += X[j] * f1 * f1 / sqrt(8 * (1 + mw[k] / mw[j]));
          }
          mu += X[k] * muk[k] / den;
        }

        trans[n + 0 * offset] = mu;
        trans[n + 1 * offset] = 0.5 * (sum1 + 1 / sum2);

        const dfloat T32 = T * sqrtT;
        for (int k = 0; k < p_Nspec; k++) {
          const dfloat Dkk = T32 * dot5LogT(diffFit + 5 * (k * p_Nspec + k), lt);
          dfloat Dk = Dkk / p;
#if p_Nspec > 1
          dfloat s = 0;
          for (int j = 0; j < p_Nspec; j++) {
            if (j != k) {
              s += X[j] / (T32 * dot5LogT(diffFit + 5 * (j * p_Nspec + k), lt));
            }
          }
          if (s > 0) {
            Dk = (W - X[k] * mw[k]) / (p * W * s);
          }
#endif
          trans[n + (2 + k) * offset] = rho * Dk;
        }
      }
    }
  }
}

// gradient variable g at volume node id
dfloat viscVar(const int g, const dlong id, const dlong offset, const dfloat *P, const dfloat *mw)
{
  if (g < 3) {
    return P[id + (p_PU + g) * offset];
  }
  if (g == 3) {
    return P[id + p_PT * offset];
  }
  const int k = g - 4;
  return P[id + (p_PY0 + k) * offset] * P[id + p_PWMEAN * offset] / mw[k];
}

// BR1 lift of gradient variable g from trace node sk (liftGrad, Zhang & Peet
// 2023 eq. 50): gr += n (avg - own) sJ w / (J w) = n (P - M)/2 sJ w / (J w).
// faceP holds M + P, so P = faceP - faceM.
void br1GradLift(const dlong sk,
                 const int g,
                 const dlong faceOffset,
                 const dfloat *sgeo,
                 const dfloat *faceM,
                 const dfloat *faceP,
                 const dfloat *mw,
                 dfloat *gr)
{
#define trM(fld) faceM[sk + (p_Neq + (fld)) * faceOffset]
#define trP(fld) (faceP[sk + (p_Neq + (fld)) * faceOffset] - trM(fld))
  dfloat jump;
  if (g < 3) {
    jump = trP(p_PU + g) - trM(p_PU + g);
  } else if (g == 3) {
    jump = trP(p_PT) - trM(p_PT);
  } else {
    const int k = g - 4;
    jump = (trP(p_PY0 + k) * trP(p_PWMEAN) - trM(p_PY0 + k) * trM(p_PWMEAN)) / mw[k];
  }
#undef trM
#undef trP
  const dfloat c = 0.5 * jump * sgeo[sk * p_Nsgeo + p_WSJID] * sgeo[sk * p_Nsgeo + p_IJWID];
  gr[0] += c * sgeo[sk * p_Nsgeo + p_NXID];
  gr[1] += c * sgeo[sk * p_Nsgeo + p_NYID];
  gr[2] += c * sgeo[sk * p_Nsgeo + p_NZID];
}

// BR1 gradient of variable g (entrovisc.f::liftGrad): strong-form derivative
// (dgdiv.f::dgGrad_strong) plus the lift above, written to grad rows 3g..3g+2.
// One launch per variable. Face node ordering as in dgSurfaceLiftHex3D.
@kernel void dgViscGradHex3D(const dlong Nelements,
                             const dlong offset,
                             const dlong faceOffset,
                             const int g,
                             @ restrict const dfloat *vgeo,
                             @ restrict const dfloat *sgeo,
                             @ restrict const dfloat *D,
                             @ restrict const dfloat *mw,
                             @ restrict const dfloat *P,
                             @ restrict const dfloat *faceM,
                             @ restrict const dfloat *faceP,
                             @ restrict dfloat *grad)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    @shared dfloat s_D[p_Nq][p_Nq];
    @shared dfloat s_q[p_Nq][p_Nq][p_Nq];

    for (int j = 0; j < p_Nq; ++j; @inner(1)) {
      for (int i = 0; i < p_Nq; ++i; @inner(0)) {
        s_D[j][i] = D[j * p_Nq + i];
        for (int k = 0; k < p_Nq; ++k) {
          const dlong id = e * p_Np + k * p_Nfp + j * p_Nq + i;
          s_q[k][j][i] = viscVar(g, id, offset, P, mw);
        }
      }
    }

    @barrier();

    for (int j = 0; j < p_Nq; ++j; @inner(1)) {
      for (int i = 0; i < p_Nq; ++i; @inner(0)) {
        const dlong base = e * p_NfacesNfp;
        for (int k = 0; k < p_Nq; ++k) {
          const dlong id = e * p_Np + k * p_Nfp + j * p_Nq + i;
          const dlong gid = e * p_Np * p_Nvgeo + k * p_Nfp + j * p_Nq + i;

          dfloat dr = 0, ds = 0, dt = 0;
          for (int l = 0; l < p_Nq; ++l) {
            dr += s_D[i][l] * s_q[k][j][l];
            ds += s_D[j][l] * s_q[k][l][i];
            dt += s_D[k][l] * s_q[l][j][i];
          }

          dfloat gr[3];
          gr[0] = vgeo[gid + p_RXID * p_Np] * dr + vgeo[gid + p_SXID * p_Np] * ds + vgeo[gid + p_TXID * p_Np] * dt;
          gr[1] = vgeo[gid + p_RYID * p_Np] * dr + vgeo[gid + p_SYID * p_Np] * ds + vgeo[gid + p_TYID * p_Np] * dt;
          gr[2] = vgeo[gid + p_RZID * p_Np] * dr + vgeo[gid + p_SZID * p_Np] * ds + vgeo[gid + p_TZID * p_Np] * dt;

          if (k == 0) {
            br1GradLift(base + 0 * p_Nfp + i + j * p_Nq, g, faceOffset, sgeo, faceM, faceP, mw, gr);
          }
          if (k == p_Nq - 1) {
            br1GradLift(base + 5 * p_Nfp + i + j * p_Nq, g, faceOffset, sgeo, faceM, faceP, mw, gr);
          }
          if (j == 0) {
            br1GradLift(base + 1 * p_Nfp + i + k * p_Nq, g, faceOffset, sgeo, faceM, faceP, mw, gr);
          }
          if (j == p_Nq - 1) {
            br1GradLift(base + 3 * p_Nfp + i + k * p_Nq, g, faceOffset, sgeo, faceM, faceP, mw, gr);
          }
          if (i == 0) {
            br1GradLift(base + 4 * p_Nfp + j + k * p_Nq, g, faceOffset, sgeo, faceM, faceP, mw, gr);
          }
          if (i == p_Nq - 1) {
            br1GradLift(base + 2 * p_Nfp + j + k * p_Nq, g, faceOffset, sgeo, faceM, faceP, mw, gr);
          }

          for (int d = 0; d < 3; d++) {
            grad[id + (3 * g + d) * offset] = gr[d];
          }
        }
      }
    }
  }
}

// Viscous flux vectors at every node (viscous.f::eval_visc_U, eval_visc_EY):
//   tau_ab = mu (du_a/dx_b + du_b/dx_a) - 2/3 mu div(u) delta_ab
//   J_k    = rho D_k W_k/W grad X_k, then J_k -= Y_k sum_j J_j
//   energy = u.tau + lambda grad T + sum_k h_k J_k
// h_k = u_k(T) + Ru T/W_k from the bi polynomials, the same per-mass enthalpy
// as compvar.f hh.
@kernel void dgViscFlux(const dlong N,
                        const dlong offset,
                        @ restrict const dfloat *bi,
                        @ restrict const dfloat *mw,
                        @ restrict const dfloat *P,
                        @ restrict const dfloat *trans,
                        @ restrict const dfloat *grad,
                        @ restrict dfloat *vflux)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    if (n < N) {
#define G(g, d) grad[n + (3 * (g) + (d)) * offset]
#define VF(q, d) vflux[n + (3 * (q) + (d)) * offset]
      const dfloat mu = trans[n + 0 * offset];
      const dfloat lambda = trans[n + 1 * offset];
      dfloat vel[3];
      vel[0] = P[n + p_PU * offset];
      vel[1] = P[n + p_PV * offset];
      vel[2] = P[n + p_PW * offset];

      const dfloat divu = G(0, 0) + G(1, 1) + G(2, 2);
      dfloat qE[3];
      for (int d = 0; d < 3; d++) {
        qE[d] = lambda * G(3, d);
      }
      for (int a = 0; a < 3; a++) {
        for (int b = 0; b < 3; b++) {
          dfloat tau = mu * (G(a, b) + G(b, a));
          if (a == b) {
            tau -= (2.0 / 3.0) * mu * divu;
          }
          VF(a, b) = tau;
          qE[b] += vel[a] * tau;
        }
      }

#if p_Nspec > 1
      const dfloat T = P[n + p_PT * offset];
      const dfloat W = P[n + p_PWMEAN * offset];
      dfloat J[p_Nspec][3];
      dfloat Jsum[3] = {0, 0, 0};
      for (int k = 0; k < p_Nspec; k++) {
        const dfloat c = trans[n + (2 + k) * offset] * mw[k] / W;
        for (int d = 0; d < 3; d++) {
          J[k][d] = c * G(4 + k, d);
          Jsum[d] += J[k][d];
        }
      }
      for (int k = 0; k < p_Nspec; k++) {
        const dfloat Yk = P[n + (p_PY0 + k) * offset];
        dfloat hk = bi[k * (p_Npa + 1) + p_Npa];
        for (int c = p_Npa - 1; c >= 0; c--) {
          hk = hk * T + bi[k * (p_Npa + 1) + c];
        }
        hk += p_Ru * T / mw[k];
        for (int d = 0; d < 3; d++) {
          J[k][d] -= Yk * Jsum[d];
          qE[d] += hk * J[k][d];
          VF(4 + k, d) = J[k][d];
        }
      }
#endif

      for (int d = 0; d < 3; d++) {
        VF(3, d) = qE[d];
      }
#undef G
#undef VF
    }
  }
}

// Normal component F_q.n of the own viscous flux at every trace node, for
// the face exchange (one field per row q instead of three: the neighbour's
// normal is -n, so after the gs-add vfaceP - vfaceM = -F_q(P).n).
@kernel void dgViscTraceGather(const dlong Nelements,
                               const dlong offset,
                               const dlong faceOffset,
                               @ restrict const dlong *vmapM,
                               @ restrict const dfloat *sgeo,
                               @ restrict const dfloat *vflux,
                               @ restrict dfloat *vfaceM)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    for (int n = 0; n < p_NfacesNfp; ++n; @inner(0)) {
      const dlong sk = e * p_NfacesNfp + n;
      const dlong idM = vmapM[sk];
      const dfloat nx = sgeo[sk * p_Nsgeo + p_NXID];
      const dfloat ny = sgeo[sk * p_Nsgeo + p_NYID];
      const dfloat nz = sgeo[sk * p_Nsgeo + p_NZID];
      for (int q = 0; q < p_Nvisc; q++) {
        vfaceM[sk + q * faceOffset] = vflux[idM + (3 * q + 0) * offset] * nx +
                                      vflux[idM + (3 * q + 1) * offset] * ny +
                                      vflux[idM + (3 * q + 2) * offset] * nz;
      }
    }
  }
}

// central BR1 face flux of row q at trace node sk (divQ_weak, Zhang & Peet
// 2023 eq. 53): (F_M + F_P)/2 . n_M sJ w / (J w). vfaceP holds
// F_M.n_M + F_P.n_P with n_P = -n_M, so (F_M + F_P)/2 . n_M = vfaceM - vfaceP/2.
dfloat br1DivFace(const dlong sk, const int q, const dlong faceOffset, const dfloat *sgeo, const dfloat *vfaceM,
                  const dfloat *vfaceP)
{
  return (vfaceM[sk + q * faceOffset] - 0.5 * vfaceP[sk + q * faceOffset]) * sgeo[sk * p_Nsgeo + p_WSJID] *
         sgeo[sk * p_Nsgeo + p_IJWID];
}

// Weak-form BR1 divergence of viscous flux row q (entrovisc.f::divQ_weak),
// added to rhs row q:
//   rhs += face term above
//        - 1/(J w)_ijk [ sum_l D_li Fr_ljk + D_lj Fs_ilk + D_lk Ft_ijl ]
// with the contravariant fluxes Fr = J w (rx Fx + ry Fy + rz Fz), etc.
// This is the exact weak form on curved elements. dgdiv.f::dgGrad_weak uses
// the metrics of node ijk and only the weight ratio of the derivative
// direction; the two agree on axis-aligned affine meshes such as the HIT box
// (see doc/dg/IMPLEMENTATION.md).
// One launch per row q.
@kernel void dgViscDivHex3D(const dlong Nelements,
                            const dlong offset,
                            const dlong faceOffset,
                            const int q,
                            @ restrict const dfloat *vgeo,
                            @ restrict const dfloat *sgeo,
                            @ restrict const dfloat *D,
                            @ restrict const dfloat *vflux,
                            @ restrict const dfloat *vfaceM,
                            @ restrict const dfloat *vfaceP,
                            @ restrict dfloat *rhs)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    @shared dfloat s_D[p_Nq][p_Nq];
    @shared dfloat s_Fr[p_Nq][p_Nq][p_Nq];
    @shared dfloat s_Fs[p_Nq][p_Nq][p_Nq];
    @shared dfloat s_Ft[p_Nq][p_Nq][p_Nq];

    for (int j = 0; j < p_Nq; ++j; @inner(1)) {
      for (int i = 0; i < p_Nq; ++i; @inner(0)) {
        s_D[j][i] = D[j * p_Nq + i];
        for (int k = 0; k < p_Nq; ++k) {
          const dlong id = e * p_Np + k * p_Nfp + j * p_Nq + i;
          const dlong gid = e * p_Np * p_Nvgeo + k * p_Nfp + j * p_Nq + i;
          const dfloat JW = vgeo[gid + p_JWID * p_Np];
          const dfloat Fx = vflux[id + (3 * q + 0) * offset];
          const dfloat Fy = vflux[id + (3 * q + 1) * offset];
          const dfloat Fz = vflux[id + (3 * q + 2) * offset];
          s_Fr[k][j][i] =
              JW * (vgeo[gid + p_RXID * p_Np] * Fx + vgeo[gid + p_RYID * p_Np] * Fy + vgeo[gid + p_RZID * p_Np] * Fz);
          s_Fs[k][j][i] =
              JW * (vgeo[gid + p_SXID * p_Np] * Fx + vgeo[gid + p_SYID * p_Np] * Fy + vgeo[gid + p_SZID * p_Np] * Fz);
          s_Ft[k][j][i] =
              JW * (vgeo[gid + p_TXID * p_Np] * Fx + vgeo[gid + p_TYID * p_Np] * Fy + vgeo[gid + p_TZID * p_Np] * Fz);
        }
      }
    }

    @barrier();

    for (int j = 0; j < p_Nq; ++j; @inner(1)) {
      for (int i = 0; i < p_Nq; ++i; @inner(0)) {
        const dlong base = e * p_NfacesNfp;
        for (int k = 0; k < p_Nq; ++k) {
          const dlong id = e * p_Np + k * p_Nfp + j * p_Nq + i;
          const dlong gid = e * p_Np * p_Nvgeo + k * p_Nfp + j * p_Nq + i;

          dfloat s = 0;
          for (int l = 0; l < p_Nq; ++l) {
            s += s_D[l][i] * s_Fr[k][j][l] + s_D[l][j] * s_Fs[k][l][i] + s_D[l][k] * s_Ft[l][j][i];
          }
          dfloat div = -s * vgeo[gid + p_IJWID * p_Np];

          if (k == 0) {
            div += br1DivFace(base + 0 * p_Nfp + i + j * p_Nq, q, faceOffset, sgeo, vfaceM, vfaceP);
          }
          if (k == p_Nq - 1) {
            div += br1DivFace(base + 5 * p_Nfp + i + j * p_Nq, q, faceOffset, sgeo, vfaceM, vfaceP);
          }
          if (j == 0) {
            div += br1DivFace(base + 1 * p_Nfp + i + k * p_Nq, q, faceOffset, sgeo, vfaceM, vfaceP);
          }
          if (j == p_Nq - 1) {
            div += br1DivFace(base + 3 * p_Nfp + i + k * p_Nq, q, faceOffset, sgeo, vfaceM, vfaceP);
          }
          if (i == 0) {
            div += br1DivFace(base + 4 * p_Nfp + j + k * p_Nq, q, faceOffset, sgeo, vfaceM, vfaceP);
          }
          if (i == p_Nq - 1) {
            div += br1DivFace(base + 2 * p_Nfp + j + k * p_Nq, q, faceOffset, sgeo, vfaceM, vfaceP);
          }

          rhs[id + q * offset] += div;
        }
      }
    }
  }
}

// SSPRK3 stage in Shu-Osher form: U <- alpha*U0 + beta*(U + dt*rhs)
@kernel void dgSSPRKStage(const dlong N,
                          const dlong offset,
                          const dfloat alpha,
                          const dfloat beta,
                          const dfloat dt,
                          @ restrict const dfloat *U0,
                          @ restrict const dfloat *rhs,
                          @ restrict dfloat *U)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    if (n < N) {
      for (int f = 0; f < p_Neq; f++) {
        const dlong id = n + f * offset;
        U[id] = alpha * U0[id] + beta * (U[id] + dt * rhs[id]);
      }
    }
  }
}

// |u| + a at every node, for the CFL estimate
@kernel void dgWaveSpeed(const dlong N, const dlong offset, @ restrict const dfloat *P, @ restrict dfloat *lambda)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    if (n < N) {
      const dfloat u = P[n + p_PU * offset];
      const dfloat v = P[n + p_PV * offset];
      const dfloat w = P[n + p_PW * offset];
      lambda[n] = sqrt(u * u + v * v + w * w) + P[n + p_PASPD * offset];
    }
  }
}
