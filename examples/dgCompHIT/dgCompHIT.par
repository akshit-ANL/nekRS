# Compressible HIT, Re_lambda = 100, Mt = 0.6, air (O2/N2), DGSEM plugin.
# nekRS port of CompNek5000 compHIT_direct_Re_lamda_100 (see README.md).
userSections = DGCOMP, CASEDATA

[GENERAL]
polynomialOrder = 7        # CompNek5000 lx1 = 8
dt = 1.5e-10               # same as base.par; nekRS rejects dt < 1e-10
stopAt = endTime
endTime = 5e-7             # ~4.51 tau0

checkpointControl = simulationTime
checkpointInterval = 5e-8
checkpointEngine = adios   # named fields (density, Y_O2, Y_N2); nek -> .fld with S01, S02, ...

[FLUID VELOCITY]
solver = none              # dgComp owns the state; nekRS only writes checkpoints
boundaryTypeMap = none     # fully periodic box
rho = 1.0                  # unused with solver = none
viscosity = 1.0            # unused with solver = none

[DGCOMP]
# The CompNek5000 reference uses the O2/N2 mixture. For single-component air
# instead: thermo = perfectGas, gamma = 1.4, gasConstant = 287.0, and drop
# nspec, species, npa and Y0 (no .dat files needed).
thermo = nasa
nspec = 2                  # O2, N2 (air1.yaml order)
species = O2, N2           # output names Y_O2, Y_N2; same order as aa.dat/mw.dat
npa = 5
riemannSolver = llf        # userparam05 = 0; hllc once M1 has it
volumeFlux = kep
viscous = no               # set to yes in M2 (BR1 + Cantera transport)
reacting = no
splitChemistry = no
clip = no
positivityLimiter = no
artificialViscosity = no
fullInterfaceLLF = no
dtChem = 2.0e-9            # userparam01, used once reacting = yes (M4)
avCstar = 1.0              # userparam02, entropy viscosity (M3)
avCmax = 0.3               # userparam03
avP = 0.7                  # userparam04

# case inputs, read by dgCompHIT.udf (not by the plugin)
[CASEDATA]
boxLength = 1.6467320829664873e-4   # base.usr L0 [m]
T0 = 300.0                 # [K]
p0 = 1.0e5                 # [Pa]
Y0 = 0.23, 0.77            # same order as species; nasa only
mu0 = 1.862349546833299e-5 # [Pa s] Cantera air at T0, p0; only for Re_lambda in stat.dat
statInterval = 1           # steps between stat.dat / stat_ref.dat rows (base.usr sfreq)
consInterval = 10          # steps between cons.dat rows (base.usr cfreq)
